def render_codex_event(event: dict) -> None:
    etype = event.get("type")

    if etype == "item.completed":
        item = event.get("item") or {}
        kind = item.get("type")

        if kind == "agent_message":
            text = item.get("text")
            if text:
                oprint(text)
            return

        if kind == "command_execution":
            cmd = item.get("command")
            output = item.get("aggregated_output")
            exit_code = item.get("exit_code")
            if cmd:
                tprint(f"  $ {cmd}")
            if output:
                tprint(output.rstrip())
            if exit_code not in (None, 0):
                tprint(f"  [exit {exit_code}]")
            return

        # Show useful tool-style items without dumping raw JSON.
        text = item.get("text") or item.get("aggregated_output")
        if text:
            oprint(text)

    elif etype in ("turn.failed", "error"):
        msg = event.get("message") or event.get("error") or event
        eprint(f"@ error: {msg}")


def tool_result_text(block: dict) -> str:
    content = block.get("content")
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        parts = []
        for part in content:
            if isinstance(part, dict) and part.get("type") == "text":
                parts.append(part.get("text", ""))
        return "\n".join(parts)
    return ""


def render_claude_event(event: dict, bash_tool_ids: set[str]) -> None:
    etype = event.get("type")

    if etype == "assistant":
        message = event.get("message") or {}
        for block in message.get("content") or []:
            if not isinstance(block, dict):
                continue
            kind = block.get("type")
            if kind == "text":
                text = block.get("text")
                if text:
                    oprint(text)
            elif kind == "tool_use":
                name = block.get("name") or "tool"
                tool_input = block.get("input") or {}
                if name == "Bash" and tool_input.get("command"):
                    if block.get("id"):
                        bash_tool_ids.add(block["id"])
                    tprint(f"  $ {tool_input['command']}")
                else:
                    target = (
                        tool_input.get("file_path")
                        or tool_input.get("path")
                        or tool_input.get("pattern")
                        or ""
                    )
                    tprint(f"  [{name} {target}]".rstrip() if target else f"  [{name}]")
        return

    if etype == "user":
        message = event.get("message") or {}
        content = message.get("content")
        if not isinstance(content, list):
            return
        for block in content:
            if isinstance(block, dict) and block.get("type") == "tool_result":
                # Only echo shell command output; other tool results
                # (file reads, searches) would flood the terminal.
                if block.get("tool_use_id") in bash_tool_ids:
                    text = tool_result_text(block)
                    if text.strip():
                        tprint(text.rstrip())
                if block.get("is_error"):
                    tprint("  [tool error]")
        return

    if etype == "result":
        # Assistant text was already streamed; only surface failures.
        if event.get("is_error"):
            msg = event.get("result") or event.get("subtype") or "unknown error"
            eprint(f"@ error: {msg}")
        return

    # Other event types (system/init handled by the caller, thinking_tokens,
    # rate_limit_event, stream noise) are intentionally silent.


def render_opencode_event(event: dict) -> None:
    etype = event.get("type")
    part = event.get("part") or {}

    if etype == "text":
        text = part.get("text")
        if text:
            oprint(text)
        return

    if etype == "tool_use":
        # One event per tool call, carrying input, output and exit code.
        tool_state = part.get("state") or {}
        if tool_state.get("status") != "completed":
            return
        tool = part.get("tool") or "tool"
        tool_input = tool_state.get("input") or {}
        if tool == "bash" and tool_input.get("command"):
            tprint(f"  $ {tool_input['command']}")
            output = tool_state.get("output")
            if output and output.strip():
                tprint(output.rstrip())
            exit_code = (tool_state.get("metadata") or {}).get("exit")
            if exit_code not in (None, 0):
                tprint(f"  [exit {exit_code}]")
        else:
            title = (
                tool_state.get("title")
                or tool_input.get("filePath")
                or tool_input.get("path")
                or ""
            )
            tprint(f"  [{tool} {title}]".rstrip() if title else f"  [{tool}]")
        return

    if etype == "error":
        msg = event.get("error") or part or event
        eprint(f"@ error: {msg}")
        return

    # step_start / step_finish and other bookkeeping events are silent.


def flush_gemini_text(text_buf: list[str]) -> None:
    if text_buf:
        text = "".join(text_buf).rstrip("\n")
        text_buf.clear()
        if text:
            oprint(text)


def render_gemini_event(event: dict, text_buf: list[str]) -> None:
    etype = event.get("type")

    if etype == "message":
        # Gemini echoes the user prompt as a message event; stay silent.
        if event.get("role") != "assistant":
            return
        content = event.get("content")
        if not content:
            return
        # Assistant text arrives as delta chunks. Emit only complete
        # lines so fragments never interleave with the spinner; the
        # remainder is flushed on the next non-message event.
        text_buf.append(content)
        joined = "".join(text_buf)
        if "\n" in joined:
            done, _, rest = joined.rpartition("\n")
            text_buf.clear()
            if rest:
                text_buf.append(rest)
            for line in done.split("\n"):
                oprint(line)
        return

    if etype == "tool_use":
        flush_gemini_text(text_buf)
        tool = event.get("tool_name") or "tool"
        params = event.get("parameters") or {}
        if tool == "run_shell_command" and params.get("command"):
            tprint(f"  $ {params['command']}")
        else:
            target = (
                params.get("file_path")
                or params.get("path")
                or params.get("pattern")
                or params.get("agent_name")
                or ""
            )
            tprint(f"  [{tool} {target}]".rstrip() if target else f"  [{tool}]")
        return

    if etype == "tool_result":
        # Gemini reports only a status here, no tool output.
        if event.get("status") not in (None, "success"):
            tprint("  [tool error]")
        return

    if etype == "error":
        flush_gemini_text(text_buf)
        msg = event.get("message") or event.get("error") or event
        eprint(f"@ error: {msg}")
        return

    if etype == "result":
        flush_gemini_text(text_buf)
        status = event.get("status")
        if status not in (None, "success"):
            eprint(f"@ error: {event.get('message') or status}")
        return

    # init and other bookkeeping events are silent.


def stream_agent(
    cmd: list[str],
    *,
    cwd: str | None,
    label: str,
    noun: str,
    handle_event,
    had_conversation: bool,
) -> int:
    """Shared backend lifecycle: spawn, stream JSON lines, spinner, ^C.

    handle_event(event) renders each parsed event and is responsible for
    saving the conversation ID eagerly when its backend reports one.
    """
    try:
        proc = subprocess.Popen(
            cmd,
            stdin=agent_stdin(),
            stdout=subprocess.PIPE,
            # Pumped through eprint below: backend diagnostics stay
            # visible but never interleave with the spinner line.
            stderr=subprocess.PIPE,
            text=True,
            bufsize=1,
            cwd=cwd,
        )
    except OSError as exc:
        eprint(f"@: failed to start {label}: {exc}")
        return 1

    def pump_stderr() -> None:
        assert proc.stderr is not None
        for raw in proc.stderr:
            raw = raw.rstrip("\n")
            if raw.strip():
                eprint(raw)

    stderr_thread = threading.Thread(target=pump_stderr, daemon=True)
    stderr_thread.start()

    global _active_spinner
    spinner = None
    if not QUIET:
        spinner = Spinner()
        _active_spinner = spinner
        spinner.start()
    interrupted = False

    try:
        assert proc.stdout is not None
        for line in proc.stdout:
            line = line.strip()
            if not line:
                continue

            try:
                event = json.loads(line)
            except json.JSONDecodeError:
                # Be resilient to unexpected non-JSON output.
                oprint(line)
                continue

            handle_event(event)

        rc = proc.wait()
        stderr_thread.join(timeout=2.0)
    except KeyboardInterrupt:
        reap_child(proc)
        rc = INTERRUPT_EXIT
        interrupted = True
    finally:
        if spinner is not None:
            spinner.stop()
            _active_spinner = None

    if interrupted:
        eprint("@: interrupted; conversation saved, ask again to continue")
    elif rc != 0 and had_conversation:
        eprint(f"@: {label} resume failed.")
        eprint(f"If the saved {noun} is stale, run: @ --new")

    return rc


def run_codex(root: Path, prompt: str, state: dict) -> int:
    if shutil.which("codex") is None:
        eprint("@: 'codex' was not found on PATH.")
        eprint("Install/authenticate the OpenAI Codex CLI first, then retry.")
        return 127

    thread_id = get_conversation(state, "codex")

    # --skip-git-repo-check: codex refuses non-git directories otherwise;
    # invoking @ in a directory is the user's explicit choice to run an
    # agent there (same rationale as gemini's --skip-trust).
    cmd = [
        "codex",
        "exec",
        "--json",
        "--color",
        "never",
        "--skip-git-repo-check",
        "-C",
        str(root),
    ]
    if MODE == "plan":
        cmd += ["--sandbox", "read-only"]
    elif MODE == "yolo":
        cmd.append("--dangerously-bypass-approvals-and-sandbox")
    else:
        cmd += ["--sandbox", "workspace-write"]
    if thread_id:
        cmd += ["resume", thread_id, prompt]
    else:
        cmd.append(prompt)

    def handle(event: dict) -> None:
        if event.get("type") == "thread.started":
            tid = event.get("thread_id")
            if tid:
                set_conversation(root, state, "codex", tid)
        render_codex_event(event)

    return stream_agent(
        cmd,
        cwd=None,
        label="Codex",
        noun="thread",
        handle_event=handle,
        had_conversation=bool(thread_id),
    )


def run_claude(root: Path, prompt: str, state: dict) -> int:
    if shutil.which("claude") is None:
        eprint("@: 'claude' was not found on PATH.")
        eprint("Install/authenticate the Claude Code CLI first, then retry.")
        return 127

    session_id = get_conversation(state, "claude")

    permission = {"plan": "plan", "yolo": "bypassPermissions"}.get(MODE, "acceptEdits")
    cmd = [
        "claude",
        "-p",
        "--output-format",
        "stream-json",
        "--verbose",
        "--permission-mode",
        permission,
    ]
    if session_id:
        cmd += ["--resume", session_id]
    cmd.append(prompt)

    bash_tool_ids: set[str] = set()

    def handle(event: dict) -> None:
        if event.get("type") == "system" and event.get("subtype") == "init":
            sid = event.get("session_id")
            if sid:
                set_conversation(root, state, "claude", sid)
        render_claude_event(event, bash_tool_ids)

    return stream_agent(
        cmd,
        cwd=str(root),
        label="Claude",
        noun="session",
        handle_event=handle,
        had_conversation=bool(session_id),
    )


def run_opencode(root: Path, prompt: str, state: dict) -> int:
    if shutil.which("opencode") is None:
        eprint("@: 'opencode' was not found on PATH.")
        eprint("Install/authenticate the opencode CLI first, then retry.")
        return 127

    session_id = get_conversation(state, "opencode")

    cmd = ["opencode", "run", "--format", "json", "--dir", str(root)]
    if MODE == "plan":
        cmd += ["--agent", "plan"]
    elif MODE == "yolo":
        cmd.append("--auto")
    if session_id:
        cmd += ["--session", session_id]
    cmd.append(prompt)

    seen = {"id": session_id}

    def handle(event: dict) -> None:
        sid = event.get("sessionID")
        if sid and sid != seen["id"]:
            seen["id"] = sid
            set_conversation(root, state, "opencode", sid)
        render_opencode_event(event)

    return stream_agent(
        cmd,
        cwd=str(root),
        label="opencode",
        noun="session",
        handle_event=handle,
        had_conversation=bool(session_id),
    )


def run_gemini(root: Path, prompt: str, state: dict) -> int:
    if shutil.which("gemini") is None:
        eprint("@: 'gemini' was not found on PATH.")
        eprint("Install/authenticate the Gemini CLI first, then retry.")
        return 127

    session_id = get_conversation(state, "gemini")

    # --skip-trust: session-scoped workspace trust, matching the other
    # backends (none of which gate on folder trust). Invoking @ in a
    # directory is the user's explicit choice to run an agent there.
    # Approval mode carries the @ execution mode: auto_edit unblocks
    # edit tools for headless runs (which cannot answer prompts), plan
    # is read-only, yolo only on the user's explicit per-call flag.
    approval = {"plan": "plan", "yolo": "yolo"}.get(MODE, "auto_edit")
    cmd = [
        "gemini",
        "--output-format",
        "stream-json",
        "--skip-trust",
        "--approval-mode",
        approval,
    ]
    if session_id:
        cmd += ["--resume", session_id]
    cmd += ["-p", prompt]

    text_buf: list[str] = []

    def handle(event: dict) -> None:
        if event.get("type") == "init":
            sid = event.get("session_id")
            if sid:
                set_conversation(root, state, "gemini", sid)
        render_gemini_event(event, text_buf)

    return stream_agent(
        cmd,
        cwd=str(root),
        label="Gemini",
        noun="session",
        handle_event=handle,
        had_conversation=bool(session_id),
    )


RUNNERS = {
    "codex": run_codex,
    "claude": run_claude,
    "opencode": run_opencode,
    "gemini": run_gemini,
}


def main(argv: list[str]) -> int:
    global QUIET, MODE
    root = repo_root()
    override = ARGV0_ALIASES.get(Path(argv[0]).name) if argv else None

    if len(argv) < 2:
        print_help()
        return 0

    # Leading flags, in any order; everything after them works as usual:
    #   @ -q fix the tests        @ --plan -q --on claude "how would you do X"
    while len(argv) > 1 and argv[1] in ("-q", "--quiet", "--plan", "--yolo"):
        flag = argv[1]
        if flag in ("-q", "--quiet"):
            QUIET = True
        elif flag == "--plan":
            if MODE == "yolo":
                eprint("@: --plan and --yolo are mutually exclusive")
                return 2
            MODE = "plan"
        else:
            if MODE == "plan":
                eprint("@: --plan and --yolo are mutually exclusive")
                return 2
            MODE = "yolo"
        argv = argv[:1] + argv[2:]
    if len(argv) < 2:
        print_help()
        return 0

    first = argv[1]

    # Commands are always '--' prefixed; anything else is a prompt for
    # the agent, so "@ save this data to a file" is never mistaken for
    # the --save command.
    if not first.startswith("-"):
        prompt = " ".join(argv[1:]).strip()
        if not prompt:
            print_help()
            return 0
        piped = read_piped_stdin()
        if piped:
            prompt = f"{prompt}\n\nPiped input:\n{piped}"
        state = load_state(root)
        backend = resolve_backend(state, override)
        return RUNNERS[backend](root, prompt, state)

    if first in ("-h", "--help"):
        print_help()
        return 0

    if first in ("-V", "--version"):
        print(f"@ {VERSION}")
        return 0

    if not first.startswith("--"):
        eprint(f"@: unknown option '{first}' (see: @ --help)")
        return 2

    command = first[2:].lower()
    args = argv[2:]

    state = load_state(root)
    backend = resolve_backend(state, override)

    if command == "on":
        choice = args[0].lower() if args else ""
        prompt = " ".join(args[1:]).strip()
        if choice not in BACKENDS or not prompt:
            eprint(f"@: usage: @ --on {'|'.join(BACKENDS)} <instruction>")
            return 2
        piped = read_piped_stdin()
        if piped:
            prompt = f"{prompt}\n\nPiped input:\n{piped}"
        return RUNNERS[choice](root, prompt, state)

    if command == "status":
        if args:
            eprint("@: usage: @ --status")
            return 2
        print(f"root:    {root}")
        print(f"backend: {backend}")
        saved = state.get("saved") or {}
        for b in BACKENDS:
            conv_id = get_conversation(state, b)
            conv = conv_id or "(new conversation)"
            names = [
                name
                for name in sorted(saved)
                if isinstance(saved[name], dict)
                and saved[name].get("backend") == b
                and saved[name].get("id") == conv_id
            ]
            note = f"  (= {', '.join(names)})" if conv_id and names else ""
            marker = "*" if b == backend else " "
            print(f"{marker} {b}:  {conv}{note}")
        if saved:
            print(f"saved:   {len(saved)} conversation(s), see: @ --list")
        print(f"state:   {state_file(root)}")
        return 0

    if command == "completion":
        shell = args[0].lower() if len(args) == 1 else ""
        if shell not in ("zsh", "bash"):
            eprint("@: usage: @ --completion zsh|bash")
            return 2
        print(completion_script(shell), end="")
        return 0

    if command == "saved-names":
        # Hidden helper for shell completion: one saved name per line.
        for name in sorted(state.get("saved") or {}):
            print(name)
        return 0

    if command == "default":
        if len(args) > 1:
            eprint(f"@: usage: @ --default [{'|'.join(BACKENDS)}]")
            return 2
        if not args:
            configured = configured_default()
            if configured:
                print(f"default backend: {configured}  ({USER_CONFIG})")
            else:
                print(f"default backend: {DEFAULT_BACKEND}  (built-in)")
            return 0
        choice = args[0].lower()
        if choice not in BACKENDS:
            eprint(f"@: usage: @ --default [{'|'.join(BACKENDS)}]")
            return 2
        cfg = load_user_config()
        cfg["backend"] = choice
        save_user_config(cfg)
        print(f"@ default backend: {choice}  ({USER_CONFIG})")
        return 0

    if command == "use":
        choice = args[0].lower() if len(args) == 1 else ""
        if choice not in BACKENDS:
            eprint(f"@: usage: @ --use {'|'.join(BACKENDS)}")
            return 2
        state["backend"] = choice
        save_state(root, state)
        print(f"@ backend for {root}: {choice}")
        return 0

    if command == "save":
        name = args[0].strip() if len(args) == 1 else ""
        if not name:
            eprint("@: usage: @ --save <name>")
            return 2
        conv = get_conversation(state, backend)
        if not conv:
            eprint(f"@: no active {backend} conversation to save")
            return 1
        existed = name in (state.get("saved") or {})
        state.setdefault("saved", {})[name] = {"backend": backend, "id": conv}
        save_state(root, state)
        verb = "updated" if existed else "saved"
        print(f"@ {verb} conversation '{name}' ({backend})")
        return 0

    if command == "switch":
        name = args[0].strip() if len(args) == 1 else ""
        if not name:
            eprint("@: usage: @ --switch <name>")
            return 2
        entry = (state.get("saved") or {}).get(name)
        target = entry.get("backend") if isinstance(entry, dict) else None
        conv_id = entry.get("id") if isinstance(entry, dict) else None
        if target not in BACKENDS or not conv_id:
            eprint(f"@: no saved conversation named '{name}' (see: @ --list)")
            return 1
        state["backend"] = target
        state[target] = {CONV_KEYS[target]: conv_id}
        save_state(root, state)
        print(f"@ switched to '{name}' ({target})")
        return 0

    if command == "list":
        if args:
            eprint("@: usage: @ --list")
            return 2
        saved = state.get("saved") or {}
        if not saved:
            print("no saved conversations for this project (use: @ --save <name>)")
            return 0
        current = get_conversation(state, backend)
        for name in sorted(saved):
            entry = saved[name] if isinstance(saved[name], dict) else {}
            target = entry.get("backend", "?")
            conv_id = entry.get("id", "?")
            marker = "*" if (target == backend and conv_id == current) else " "
            print(f"{marker} {name}  [{target}]  {conv_id}")
        return 0

    if command == "update":
        if args:
            eprint("@: usage: @ --update")
            return 2
        return self_update()

    if command == "color":
        if len(args) > 1:
            eprint(f"@: usage: @ --color [{'|'.join(SPINNER_COLORS)}|random]")
            return 2
        if not args:
            configured = configured_color()
            if configured:
                print(f"spinner color: {configured}  ({USER_CONFIG})")
            else:
                print("spinner color: random  (built-in)")
            return 0
        choice = args[0].lower()
        cfg = load_user_config()
        if choice == "random":
            cfg.pop("color", None)
            save_user_config(cfg)
            print("@ spinner color: random")
            return 0
        if choice not in SPINNER_COLORS:
            eprint(f"@: usage: @ --color [{'|'.join(SPINNER_COLORS)}|random]")
            return 2
        cfg["color"] = choice
        save_user_config(cfg)
        print(f"@ spinner color: {choice}  ({USER_CONFIG})")
        return 0

    if command == "spinner-test":
        if len(args) > 2:
            eprint("@: usage: @ --spinner-test [style] [color]")
            return 2
        style = args[0] if args else None
        color = args[1] if len(args) > 1 else None
        spinner = Spinner(style, color)
        spinner.start()
        try:
            time.sleep(3)
        finally:
            spinner.stop()
        print(f"spinner test complete ({spinner.style}, {spinner.color})")
        return 0

    if command == "forget" and len(args) == 1:
        name = args[0].strip()
        saved = state.get("saved") or {}
        if name not in saved:
            eprint(f"@: no saved conversation named '{name}' (see: @ --list)")
            return 1
        del saved[name]
        save_state(root, state)
        print(f"@ forgot saved conversation '{name}'")
        return 0

    if command in ("new", "forget", "reset"):
        if args:
            eprint(f"@: usage: @ --{command}" + (" [name]" if command == "forget" else ""))
            return 2
        forget_conversation(root, state, backend)
        if command == "new":
            print(f"@ new {backend} conversation for {root}")
        else:
            print(f"@ forgot {backend} conversation for {root}")
        return 0

    eprint(f"@: unknown command '--{command}' (see: @ --help)")
    return 2


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv))
    except KeyboardInterrupt:
        print("@: interrupted", file=sys.stderr)
        raise SystemExit(INTERRUPT_EXIT)
