class WordTicker:
    """Types, holds and deletes loading words with a human rhythm.

    Fast, machine-confident keystrokes (8-30 ms) with rare micro
    hesitations for texture; deletion starts quick and accelerates
    like a held backspace key. A fully typed word holds for 7-15 s,
    so the word changes on that cadence. Driven by the spinner's frame
    ticks: text(now) advances whatever actions are due and returns the
    currently visible part.
    """

    TYPE_DELAY = (0.002, 0.007)
    HESITATE = 0.05            # chance of a micro pause after a keystroke
    HESITATE_DELAY = (0.03, 0.08)
    HOLD = (7.0, 15.0)
    DELETE_START = 0.05        # first backspace delay...
    DELETE_ACCEL = 0.70        # ...then each one this much faster,
    DELETE_MIN = 0.012         # down to this floor
    GAP = (0.25, 0.7)          # blank pause before the next word

    def __init__(self):
        self._word = random.choice(LOADING_WORDS)
        self._shown = 0
        self._state = "typing"
        self._delete_delay = self.DELETE_START
        self._next = time.monotonic() + random.uniform(*self.TYPE_DELAY)

    def _advance(self, now: float) -> None:
        if self._state == "typing":
            self._shown += 1
            if self._shown == len(self._word):
                self._state = "holding"
                self._next = now + random.uniform(*self.HOLD)
                return
            self._next = now + random.uniform(*self.TYPE_DELAY)
            if random.random() < self.HESITATE:
                self._next += random.uniform(*self.HESITATE_DELAY)
        elif self._state == "holding":
            self._state = "deleting"
            self._delete_delay = self.DELETE_START
            self._next = now + self._delete_delay
        elif self._state == "deleting":
            self._shown -= 1
            if self._shown == 0:
                self._state = "gap"
                self._next = now + random.uniform(*self.GAP)
                return
            self._delete_delay = max(self.DELETE_MIN, self._delete_delay * self.DELETE_ACCEL)
            self._next = now + self._delete_delay
        else:  # gap
            others = [w for w in LOADING_WORDS if w != self._word]
            self._word = random.choice(others or LOADING_WORDS)
            self._shown = 0
            self._state = "typing"
            self._next = now + random.uniform(*self.TYPE_DELAY)

    def text(self, now: float) -> str:
        while now >= self._next:
            self._advance(now)
        return self._word[: self._shown]


class Spinner:
    """Thinking indicator on a single terminal line.

    Each run randomly picks one of the cli-spinners "dots" styles and a
    base color, which "breathes" (brightness pulses) while it spins. The
    user can pin the color via '@ --color <name>'. An explicitly
    requested but unknown style falls back to "dots"; an unknown color
    to a random one. Color is skipped when NO_COLOR is set or TERM is
    dumb/absent; truecolor is used when COLORTERM advertises it, with a
    256-color fallback otherwise.
    Draws to /dev/tty when available, else to stderr if stderr is an
    interactive TTY, else stays silent. Redirected/piped output never
    receives spinner frames. All visible output during a run must go
    through emit() so a frame is cleared before real text appears.
    """

    BREATH_MIN = 0.35   # dimmest point, as a fraction of the base color
    BREATH_STEPS = 26   # one full breath ≈ 2 s at the ~80 ms frame interval
    RESET = "\x1b[0m"

    def __init__(self, style: str | None = None, color: str | None = None):
        if style is None:
            style = random.choice(tuple(SPINNER_STYLES))
        elif style not in SPINNER_STYLES:
            style = DEFAULT_SPINNER
        self.style = style
        if color is None:
            color = configured_color()
        if color not in SPINNER_COLORS:
            color = random.choice(tuple(SPINNER_COLORS))
        self.color = color
        self._prefixes = self._breath_prefixes()
        self._interval, self._frames = SPINNER_STYLES[style]
        self._words = WordTicker()
        self._last_len = 0  # visible chars of the last drawn line
        self._fh = None
        self._owns_fh = False
        try:
            self._fh = open("/dev/tty", "w", errors="replace")
            self._owns_fh = True
        except OSError:
            if sys.stderr.isatty():
                self._fh = sys.stderr
        self._lock = threading.Lock()
        self._stop_event = threading.Event()
        self._thread: threading.Thread | None = None
        self._drawn = False

    def _breath_prefixes(self) -> tuple[str, ...]:
        """ANSI color prefixes for one breath cycle, dim-bright-dim.

        Empty when color must not be used; the run loop then writes
        plain frames.
        """
        if os.environ.get("NO_COLOR") is not None:
            return ()
        term = os.environ.get("TERM", "")
        if not term or term == "dumb":
            return ()
        colorterm = os.environ.get("COLORTERM", "").lower()
        truecolor = "truecolor" in colorterm or "24bit" in colorterm
        base = SPINNER_COLORS[self.color]
        prefixes = []
        for i in range(self.BREATH_STEPS):
            phase = math.cos(2 * math.pi * i / self.BREATH_STEPS)
            factor = self.BREATH_MIN + (1 - self.BREATH_MIN) * (0.5 + 0.5 * phase)
            r, g, b = (round(c * factor) for c in base)
            if truecolor:
                prefixes.append(f"\x1b[38;2;{r};{g};{b}m")
            else:
                code = 16 + 36 * round(r / 255 * 5) + 6 * round(g / 255 * 5) + round(b / 255 * 5)
                prefixes.append(f"\x1b[38;5;{code}m")
        return tuple(prefixes)

    @property
    def enabled(self) -> bool:
        return self._fh is not None

    def start(self) -> None:
        if not self.enabled or self._thread is not None:
            return
        self._stop_event.clear()
        self._thread = threading.Thread(target=self._run, daemon=True)
        self._thread.start()

    def _run(self) -> None:
        i = 0
        while not self._stop_event.wait(self._interval):
            with self._lock:
                frame = self._frames[i % len(self._frames)]
                word = self._words.text(time.monotonic())
                # The separator space is part of the layout, never deleted.
                line = f"{frame} {word}"
                # Pad over leftovers when the line shrinks (word deleting).
                pad = " " * max(0, self._last_len - len(line))
                if self._prefixes:
                    prefix = self._prefixes[i % len(self._prefixes)]
                    out = prefix + line + self.RESET
                else:
                    out = line
                try:
                    self._fh.write("\r" + out + pad)
                    self._fh.flush()
                except (OSError, ValueError):
                    return
                self._last_len = len(line)
                self._drawn = True
            i += 1

    def _clear_locked(self) -> None:
        if self._drawn:
            try:
                self._fh.write("\r" + " " * self._last_len + "\r")
                self._fh.flush()
            except (OSError, ValueError):
                pass
            self._drawn = False

    def emit(self, stream, *args, **kwargs) -> None:
        with self._lock:
            self._clear_locked()
            print(*args, file=stream, flush=True, **kwargs)

    def stop(self) -> None:
        if not self.enabled:
            return
        self._stop_event.set()
        if self._thread is not None:
            self._thread.join(timeout=1.0)
            self._thread = None
        with self._lock:
            self._clear_locked()
        if self._owns_fh:
            try:
                self._fh.close()
            except OSError:
                pass
            self._fh = None


_active_spinner: Spinner | None = None

# Quiet mode (-q): no spinner, no tool/command echo — answer only.
QUIET = False

# Execution mode, per invocation only (never sticky, never a default):
#   normal — the agent may edit files in the workspace
#   plan   — read-only: analyze and plan, no changes
#   yolo   — auto-approve everything the backend allows (dangerous)
MODE = "normal"


def oprint(*args, **kwargs):
    spinner = _active_spinner
    if spinner is not None and spinner.enabled:
        spinner.emit(sys.stdout, *args, **kwargs)
    else:
        print(*args, flush=True, **kwargs)


def eprint(*args, **kwargs):
    spinner = _active_spinner
    if spinner is not None and spinner.enabled:
        spinner.emit(sys.stderr, *args, **kwargs)
    else:
        print(*args, file=sys.stderr, **kwargs)


def tprint(*args, **kwargs):
    """Tool/command echo to stderr; silenced by quiet mode (-q).

    Errors and warnings must use eprint so they survive quiet mode.
    """
    if not QUIET:
        eprint(*args, **kwargs)


def repo_root() -> Path:
    try:
        out = subprocess.check_output(
            ["git", "rev-parse", "--show-toplevel"],
            stderr=subprocess.DEVNULL,
            text=True,
        ).strip()
        if out:
            return Path(out).resolve()
    except (subprocess.CalledProcessError, FileNotFoundError):
        pass
    return Path.cwd().resolve()


def state_dir() -> Path:
    base = os.environ.get("XDG_STATE_HOME")
    if base:
        root = Path(base)
    else:
        root = Path.home() / ".local" / "state"
    path = root / "at-agent"
    path.mkdir(parents=True, exist_ok=True)
    return path


def state_file(root: Path) -> Path:
    digest = hashlib.sha256(str(root).encode()).hexdigest()[:20]
    return state_dir() / f"{digest}.json"


def load_state(root: Path) -> dict:
    path = state_file(root)
    if not path.exists():
        return {}
    try:
        state = json.loads(path.read_text())
    except (json.JSONDecodeError, OSError):
        return {}
    if not isinstance(state, dict):
        return {}
    # Migrate legacy format: a top-level thread_id was a Codex conversation.
    legacy_thread = state.pop("thread_id", None)
    if legacy_thread and not state.get("codex"):
        state["codex"] = {"thread_id": legacy_thread}
    return state


def save_state(root: Path, state: dict) -> None:
    state = {k: v for k, v in state.items() if v}
    state["root"] = str(root)
    # Write-then-rename so concurrent @ calls in the same repo never
    # interleave partial writes; the pid keeps temp names distinct.
    path = state_file(root)
    tmp = path.with_name(f"{path.name}.{os.getpid()}.tmp")
    tmp.write_text(json.dumps(state, indent=2) + "\n")
    os.replace(tmp, path)


def load_user_config() -> dict:
    try:
        cfg = json.loads(USER_CONFIG.read_text())
    except (OSError, json.JSONDecodeError):
        return {}
    return cfg if isinstance(cfg, dict) else {}


def save_user_config(cfg: dict) -> None:
    USER_CONFIG.parent.mkdir(parents=True, exist_ok=True)
    tmp = USER_CONFIG.with_name(f"{USER_CONFIG.name}.{os.getpid()}.tmp")
    tmp.write_text(json.dumps(cfg, indent=2) + "\n")
    os.replace(tmp, USER_CONFIG)


def configured_default() -> str | None:
    backend = (load_user_config().get("backend") or "").strip().lower()
    return backend if backend in BACKENDS else None


def configured_color() -> str | None:
    color = (load_user_config().get("color") or "").strip().lower()
    return color if color in SPINNER_COLORS else None


def resolve_backend(state: dict, override: str | None = None) -> str:
    if override in BACKENDS:
        return override
    backend = state.get("backend") or os.environ.get("AT_AGENT_BACKEND", "")
    backend = backend.strip().lower()
    if backend in BACKENDS:
        return backend
    backend = configured_default()
    if backend:
        return backend
    # Nothing chosen anywhere: prefer the built-in default, but fall
    # back to any installed backend so first runs work out of the box.
    if shutil.which(DEFAULT_BACKEND):
        return DEFAULT_BACKEND
    for candidate in BACKENDS:
        if shutil.which(candidate):
            return candidate
    return DEFAULT_BACKEND


def get_conversation(state: dict, backend: str) -> str | None:
    sub = state.get(backend)
    if isinstance(sub, dict):
        return sub.get(CONV_KEYS[backend])
    return None


def set_conversation(root: Path, state: dict, backend: str, conv_id: str) -> None:
    state[backend] = {CONV_KEYS[backend]: conv_id}
    save_state(root, state)


def forget_conversation(root: Path, state: dict, backend: str) -> None:
    state.pop(backend, None)
    keep = (
        any(state.get(b) for b in BACKENDS)
        or state.get("backend")
        or state.get("saved")
    )
    if keep:
        save_state(root, state)
    else:
        try:
            state_file(root).unlink()
        except FileNotFoundError:
            pass


INTERRUPT_EXIT = 130  # 128 + SIGINT, the usual shell convention


def reap_child(proc: subprocess.Popen) -> None:
    """Stop the backend child after Ctrl-C without leaving a zombie.

    A terminal Ctrl-C usually reaches the child too (same foreground
    process group), so terminate() is often a no-op; it matters when
    only the wrapper was signalled.
    """
    try:
        proc.terminate()
        proc.wait(timeout=2)
    except subprocess.TimeoutExpired:
        try:
            proc.kill()
            proc.wait(timeout=1)
        except (OSError, subprocess.TimeoutExpired):
            pass
    except OSError:
        pass


def agent_stdin():
    """stdin for the backend subprocess.

    Inherit a real terminal (backends stay quiet and behave as if run
    directly). Anything else was already consumed by read_piped_stdin,
    so hand the backend DEVNULL rather than a drained pipe.
    """
    return None if sys.stdin.isatty() else subprocess.DEVNULL


def read_piped_stdin() -> str:
    """Return piped stdin as text, or "" when stdin is a terminal.

    The data is embedded into the prompt so the backend receives one
    unambiguous instruction; the backend subprocess itself gets DEVNULL
    and never reads the pipe directly.
    """
    if sys.stdin.isatty():
        return ""
    try:
        sys.stdin.reconfigure(errors="replace")
        # UTF-8 is at least one byte per character, so this reads enough
        # to detect any input whose encoded size exceeds the byte limit.
        data = sys.stdin.read(MAX_STDIN_BYTES + 1)
    except (OSError, AttributeError):
        return ""
    encoded = data.encode("utf-8", "replace")
    if len(encoded) > MAX_STDIN_BYTES:
        data = encoded[:MAX_STDIN_BYTES].decode("utf-8", "ignore")
        data += "\n[stdin truncated]"
        eprint(f"@: piped input truncated to {MAX_STDIN_BYTES} bytes")
    return data.strip("\n")


def completion_script(shell: str) -> str:
    """Completion script for zsh or bash, built from the real command,
    backend and spinner-style lists so it can never drift from them.

    Saved conversation names are fetched at completion time via the
    hidden '@ --saved-names' helper (one name per line).
    """
    commands = " ".join(name for name, _ in COMPLETION_COMMANDS)
    described = " ".join(f"'{name}:{desc}'" for name, desc in COMPLETION_COMMANDS)
    backends = " ".join(BACKENDS)
    styles = " ".join(SPINNER_STYLES)
    colors = " ".join((*SPINNER_COLORS, "random"))
    names = " ".join(("@", *ARGV0_ALIASES))

    if shell == "zsh":
        return f"""\
# @ completion for zsh. Load with:  eval "$(@ --completion zsh)"
_at_agent() {{
  local -a matches
  local off=0
  [[ ${{words[2]}} == -q || ${{words[2]}} == --quiet ]] && off=1
  if (( CURRENT == 2 + off )); then
    if [[ ${{words[CURRENT]}} == -* ]]; then
      matches=({described})
      _describe 'command' matches
      return
    fi
    _default
    return
  fi
  if (( CURRENT == 3 + off )); then
    case ${{words[2 + off]}} in
      --use|--default|--on)
        _values 'backend' {backends}; return ;;
      --switch|--forget)
        matches=(${{(f)"$(command @ --saved-names 2>/dev/null)"}})
        (( ${{#matches}} )) && _values 'conversation' $matches
        return ;;
      --completion)
        _values 'shell' zsh bash; return ;;
      --color)
        _values 'color' {colors}; return ;;
      --spinner-test)
        _values 'style' {styles}; return ;;
    esac
  fi
  if (( CURRENT == 4 + off )) && [[ ${{words[2 + off]}} == --spinner-test ]]; then
    _values 'color' {colors}
    return
  fi
  _default
}}
compdef _at_agent {names}
"""

    return f"""\
# @ completion for bash. Load with:  eval "$(@ --completion bash)"
_at_agent() {{
  local cur=${{COMP_WORDS[COMP_CWORD]}}
  local off=0
  [[ ${{COMP_WORDS[1]}} == -q || ${{COMP_WORDS[1]}} == --quiet ]] && off=1
  if [[ $COMP_CWORD -eq $((1 + off)) && $cur == -* ]]; then
    COMPREPLY=( $(compgen -W "{commands}" -- "$cur") )
    return
  fi
  if [[ $COMP_CWORD -eq $((2 + off)) ]]; then
    case ${{COMP_WORDS[1 + off]}} in
      --use|--default|--on)
        COMPREPLY=( $(compgen -W "{backends}" -- "$cur") ) ;;
      --switch|--forget)
        local IFS=$'\\n'
        COMPREPLY=( $(compgen -W "$(command @ --saved-names 2>/dev/null)" -- "$cur") ) ;;
      --completion)
        COMPREPLY=( $(compgen -W "zsh bash" -- "$cur") ) ;;
      --color)
        COMPREPLY=( $(compgen -W "{colors}" -- "$cur") ) ;;
      --spinner-test)
        COMPREPLY=( $(compgen -W "{styles}" -- "$cur") ) ;;
    esac
  fi
  if [[ $COMP_CWORD -eq $((3 + off)) && ${{COMP_WORDS[1 + off]}} == --spinner-test ]]; then
    COMPREPLY=( $(compgen -W "{colors}" -- "$cur") )
  fi
}}
complete -F _at_agent {names}
"""


def self_update() -> int:
    """Replace this script with the latest version from the repo.

    The download is validated (shebang, parses as Python) before it
    atomically replaces the running file, so a failed or garbage
    download can never leave a broken @ behind.
    """
    target = Path(__file__).resolve()

    try:
        with urllib.request.urlopen(UPDATE_URL, timeout=30) as resp:
            data = resp.read()
    except (urllib.error.URLError, OSError) as exc:
        eprint(f"@: update failed: {exc}")
        return 1

    try:
        text = data.decode("utf-8")
    except UnicodeDecodeError:
        eprint("@: update failed: downloaded file is not valid UTF-8")
        return 1

    if not text.startswith("#!"):
        eprint("@: update failed: downloaded file does not look like a script")
        return 1
    try:
        compile(text, str(target), "exec")
    except (SyntaxError, ValueError) as exc:
        eprint(f"@: update failed: downloaded file does not parse: {exc}")
        return 1

    match = re.search(r'^VERSION = "([^"]+)"', text, re.MULTILINE)
    new_version = match.group(1) if match else "unknown"

    try:
        if text == target.read_text():
            print(f"@ {VERSION} is already up to date")
            return 0
    except OSError:
        pass  # unreadable current file: proceed with the replacement

    tmp = target.with_name(f"{target.name}.{os.getpid()}.tmp")
    try:
        tmp.write_text(text)
        tmp.chmod(target.stat().st_mode)
        os.replace(tmp, target)
    except OSError as exc:
        try:
            tmp.unlink()
        except OSError:
            pass
        eprint(f"@: update failed: {exc}")
        return 1

    print(f"@ updated: {VERSION} -> {new_version} ({target})")
    return 0


